{
  "fp16": {
    "enabled": true
  },
  "bf16": {
    "enabled": false
  },
  "zero_optimization": {
    "stage": 2,
    "offload_optimizer": {
      "device": "none"
    },
    "allgather_partitions": true,
    "allgather_bucket_size": 2e8,
    "overlap_comm": true,
    "reduce_scatter": true,
    "reduce_bucket_size": 2e8,
    "contiguous_gradients": true
  },
  "train_batch_size": 64,
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 1e-2,
      "betas": [0.9, 0.999],
      "eps": 1e-8
    }
  }
}
